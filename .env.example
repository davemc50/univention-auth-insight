# Site-specific Auth Insight deployment settings.
# Copy to .env and customize before running scripts/setup-remote-logs.sh
#
# JSON array of remote docker hosts (Authelia / SSO containers).
# See docs/remote-docker-logs.md for the schema.

AUTHIN_REMOTE_ENABLED=true

AUTHIN_REMOTE_HOSTS_JSON='[
  {
    "name": "remote-sso",
    "host": "docker-host-a.example.com",
    "user": "deploy",
    "containers": [
      {
        "name": "authelia",
        "label": "Authelia SSO (public apps)"
      }
    ]
  },
  {
    "name": "internal-sso",
    "host": "docker-host-b.example.com",
    "user": "ops",
    "sudo": true,
    "containers": [
      {
        "name": "authelia",
        "label": "Authelia SSO (internal apps)"
      }
    ]
  }
]'

# Optional legacy single-host keys (used when AUTHIN_REMOTE_HOSTS_JSON is empty):
# AUTHIN_REMOTE_HOST=docker-host.example.com
# AUTHIN_REMOTE_USER=deploy
# AUTHIN_REMOTE_CONTAINERS=authelia
# AUTHIN_REMOTE_LABELS=authelia=Authelia SSO

# E2E tests (optional; copy to .env.e2e)
UMC_AUTHIN_URL=https://ucs-primary.example.com/univention/management/
UMC_AUTHIN_USER=Administrator
UMC_AUTHIN_PASSWORD=
